<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pranjali Rawale Makeover | Luxury Bridal & Professional Makeup Artist</title>
    <meta name="description" content="Professional luxury bridal makeup artist Pranjali Rawale. Specializing in bridal makeovers, HD makeup, reception glam, and engagement looks. Book via WhatsApp.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --ivory: #FAF7F2;
            --cream: #F4EEDC;
            --gold: #C5A059;
            --gold-light: #F3E9C9;
            --gold-dark: #9A7B38;
            --charcoal: #2A2421;
            --subtext: #6A5E5B;
            --white: #FFFFFF;
            --shadow-soft: 0 20px 40px rgba(197, 160, 89, 0.08);
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--ivory);
            color: var(--charcoal);
            line-height: 1.8;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .serif {
            font-family: 'Cormorant Garamond', serif;
        }

        /* --- NAVIGATION --- */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(250, 247, 242, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(197, 160, 89, 0.2);
            transition: var(--transition);
        }

        .nav-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 15px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo-box {
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
        }

        .logo-img {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--gold);
            box-shadow: 0 0 15px rgba(197, 160, 89, 0.3);
        }

        .brand-text h1 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--charcoal);
            line-height: 1.1;
            letter-spacing: 0.5px;
        }

        .brand-text span {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--gold-dark);
            font-weight: 600;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--subtext);
            font-size: 0.95rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--gold-dark);
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            color: var(--white);
            padding: 12px 28px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(197, 160, 89, 0.3);
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            cursor: pointer;
        }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(197, 160, 89, 0.5);
        }

        .menu-toggle {
            display: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: var(--charcoal);
        }

        /* --- HERO SECTION --- */
        .hero {
            padding: 170px 20px 110px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: radial-gradient(circle at 85% 20%, rgba(197, 160, 89, 0.12) 0%, transparent 45%),
                        radial-gradient(circle at 10% 85%, rgba(244, 238, 220, 0.6) 0%, transparent 55%);
        }

        .hero-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 60px;
            align-items: center;
        }

        .section-tag {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: var(--gold-dark);
            font-weight: 700;
            margin-bottom: 15px;
            display: inline-block;
        }

        .hero-content h2 {
            font-size: 4rem;
            line-height: 1.1;
            margin-bottom: 20px;
            color: var(--charcoal);
        }

        .hero-content h2 span {
            color: var(--gold-dark);
            font-style: italic;
        }

        .hero-content p {
            font-size: 1.1rem;
            color: var(--subtext);
            margin-bottom: 35px;
            max-width: 520px;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .btn-outline {
            border: 2px solid var(--gold);
            color: var(--charcoal);
            padding: 10px 26px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-outline:hover {
            background: var(--gold);
            color: var(--white);
        }

        .hero-img-stack {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            position: relative;
        }

        .hero-img-box {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            border: 4px solid var(--white);
            background: var(--white);
        }

        .hero-img-box:nth-child(2) {
            transform: translateY(35px);
        }

        .hero-img-box img {
            width: 100%;
            height: 330px;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .hero-img-box:hover img {
            transform: scale(1.05);
        }

        /* --- ABOUT SECTION --- */
        .about {
            padding: 130px 20px;
            background: var(--white);
        }

        .about-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1.1fr;
            gap: 70px;
            align-items: center;
        }

        .about-image {
            position: relative;
        }

        .about-image img {
            width: 100%;
            border-radius: 16px;
            box-shadow: var(--shadow-soft);
            border: 4px solid var(--ivory);
        }

        .experience-badge {
            position: absolute;
            bottom: -30px;
            right: -25px;
            background: var(--charcoal);
            color: var(--gold-light);
            padding: 30px;
            border-radius: 16px;
            text-align: center;
            border: 2px solid var(--gold);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

        .experience-badge span {
            font-size: 2.5rem;
            font-weight: 700;
            display: block;
            font-family: 'Cormorant Garamond', serif;
            color: var(--gold);
        }

        .about-text h3 {
            font-size: 3rem;
            margin-bottom: 25px;
            line-height: 1.2;
        }

        .about-text p {
            color: var(--subtext);
            margin-bottom: 20px;
        }

        /* --- SERVICES SECTION --- */
        .services {
            padding: 130px 20px;
            background: var(--cream);
        }

        .section-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 70px;
        }

        .section-header h3 {
            font-size: 3.2rem;
            margin-bottom: 15px;
            color: var(--charcoal);
        }

        .services-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 35px;
        }

        .service-card {
            background: var(--white);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            transition: var(--transition);
            border: 1px solid rgba(197, 160, 89, 0.2);
            display: flex;
            flex-direction: column;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px rgba(197, 160, 89, 0.2);
        }

        .service-img {
            height: 270px;
            overflow: hidden;
        }

        .service-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .service-card:hover .service-img img {
            transform: scale(1.07);
        }

        .service-body {
            padding: 30px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .service-body h4 {
            font-size: 1.8rem;
            margin-bottom: 12px;
        }

        .service-body p {
            color: var(--subtext);
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .service-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(197, 160, 89, 0.15);
            padding-top: 20px;
        }

        .service-price {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--gold-dark);
        }

        /* --- PORTFOLIO GALLERY --- */
        .portfolio {
            padding: 130px 20px;
            background: var(--ivory);
        }

        .filter-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--white);
            border: 1px solid rgba(197, 160, 89, 0.3);
            padding: 10px 26px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--charcoal);
            transition: var(--transition);
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--gold);
            color: var(--white);
            border-color: var(--gold);
        }

        .gallery-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
        }

        .gallery-item {
            border-radius: 16px;
            overflow: hidden;
            height: 380px;
            position: relative;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            background: var(--white);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .gallery-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(42, 36, 33, 0.85) 0%, transparent 60%);
            opacity: 0;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 25px;
            color: var(--white);
        }

        .gallery-item:hover img {
            transform: scale(1.08);
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-overlay h5 {
            font-size: 1.4rem;
            color: var(--gold-light);
            font-family: 'Cormorant Garamond', serif;
        }

        /* --- LIGHTBOX --- */
        .lightbox {
            position: fixed;
            inset: 0;
            background: rgba(42, 36, 33, 0.92);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
            backdrop-filter: blur(8px);
        }

        .lightbox.active {
            display: flex;
        }

        .lightbox img {
            max-width: 90%;
            max-height: 85vh;
            border-radius: 12px;
            border: 3px solid var(--gold);
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .lightbox-close {
            position: absolute;
            top: 30px;
            right: 40px;
            color: var(--white);
            font-size: 2.5rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .lightbox-close:hover {
            color: var(--gold);
        }

        /* --- PRICING --- */
        .pricing {
            padding: 130px 20px;
            background: var(--white);
        }

        .pricing-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 35px;
        }

        .pricing-card {
            background: var(--ivory);
            border-radius: 20px;
            padding: 40px;
            border: 2px solid rgba(197, 160, 89, 0.3);
            position: relative;
            box-shadow: var(--shadow-soft);
            transition: var(--transition);
        }

        .pricing-card.featured {
            border-color: var(--gold);
            background: linear-gradient(to bottom, var(--white) 0%, var(--cream) 100%);
            transform: scale(1.03);
        }

        .pricing-badge {
            position: absolute;
            top: -15px;
            right: 30px;
            background: var(--gold);
            color: var(--white);
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .pricing-card h4 {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .pricing-amount {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 700;
            color: var(--gold-dark);
            margin: 20px 0;
        }

        .pricing-features {
            list-style: none;
            margin: 30px 0;
        }

        .pricing-features li {
            padding: 10px 0;
            border-bottom: 1px solid rgba(197, 160, 89, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            color: var(--subtext);
        }

        .pricing-features li i {
            color: var(--gold-dark);
        }

        /* --- TESTIMONIALS --- */
        .testimonials {
            padding: 130px 20px;
            background: var(--cream);
        }

        .testimonials-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .testimonial-card {
            background: var(--white);
            padding: 40px;
            border-radius: 20px;
            border: 1px solid rgba(197, 160, 89, 0.2);
            box-shadow: var(--shadow-soft);
        }

        .testimonial-card i.fa-quote-left {
            font-size: 2.5rem;
            color: rgba(197, 160, 89, 0.25);
            margin-bottom: 15px;
            display: block;
        }

        .testimonial-stars {
            color: var(--gold);
            margin-bottom: 15px;
        }

        .testimonial-card p {
            font-style: italic;
            color: var(--subtext);
            margin-bottom: 25px;
        }

        .client-info h5 {
            font-size: 1.2rem;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .client-info span {
            font-size: 0.85rem;
            color: var(--gold-dark);
        }

        /* --- FAQ SECTION --- */
        .faq {
            padding: 130px 20px;
            background: var(--ivory);
        }

        .faq-container {
            max-width: 850px;
            margin: 0 auto;
        }

        .faq-item {
            background: var(--white);
            margin-bottom: 20px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(197, 160, 89, 0.25);
            box-shadow: 0 5px 15px rgba(0,0,0,0.02);
        }

        .faq-question {
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--charcoal);
        }

        .faq-answer {
            padding: 0 30px 22px;
            color: var(--subtext);
            display: none;
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            display: block;
        }

        .faq-question i {
            transition: transform 0.3s ease;
            color: var(--gold-dark);
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        /* --- BOOKING FORM --- */
        .booking {
            padding: 130px 20px;
            background: linear-gradient(135deg, var(--charcoal) 0%, #1A1513 100%);
            color: var(--white);
        }

        .booking-box {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.04);
            padding: 60px;
            border-radius: 24px;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(197, 160, 89, 0.35);
            box-shadow: 0 30px 60px rgba(0,0,0,0.4);
        }

        .booking-box .section-header h3 {
            color: var(--white);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 0.9rem;
            color: var(--gold-light);
            font-weight: 500;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(197, 160, 89, 0.3);
            padding: 15px 20px;
            border-radius: 12px;
            color: var(--white);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1rem;
            transition: var(--transition);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--gold);
            background: rgba(255, 255, 255, 0.12);
        }

        .form-control option {
            background: var(--charcoal);
            color: var(--white);
        }

        /* --- FOOTER --- */
        footer {
            background: var(--charcoal);
            color: var(--white);
            padding: 80px 20px 40px;
            border-top: 1px solid rgba(197, 160, 89, 0.2);
        }

        .footer-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 50px;
            margin-bottom: 60px;
        }

        .footer-col h4 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: var(--gold);
        }

        .footer-col p {
            color: #B5A8A5;
            margin-bottom: 20px;
            font-size: 0.95ln;
            line-height: 1.7;
        }

        .social-links {
            display: flex;
            gap: 15px;
        }

        .social-links a {
            width: 45px;
            height: 45px;
            background: rgba(197, 160, 89, 0.1);
            border: 1px solid var(--gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            text-decoration: none;
            transition: var(--transition);
        }

        .social-links a:hover {
            background: var(--gold);
            color: var(--charcoal);
            transform: translateY(-3px);
        }

        .footer-bottom {
            max-width: 1300px;
            margin: 0 auto;
            padding-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.08);
            text-align: center;
            color: #9C8E8B;
            font-size: 0.9rem;
        }

        /* --- RESPONSIVE --- */
        @media(max-width: 992px) {
            .hero-grid, .about-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .hero-content h2 {
                font-size: 3.2rem;
            }
            .nav-links {
                display: none;
            }
            .menu-toggle {
                display: block;
            }
        }

        @media(max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .form-group.full {
                grid-column: span 1;
            }
            .hero-content h2 {
                font-size: 2.6rem;
            }
            .booking-box {
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- NAVIGATION -->
    <header>
        <div class="nav-container">
            <a href="#" class="logo-box">
                <img src="Prlogoborderradius.png" alt="Pranjali Rawale Logo" class="logo-img">
                <div class="brand-text">
                    <h1>Pranjali Rawale</h1>
                    <span>Makeover</span>
                </div>
            </a>
            <ul class="nav-links">
                <li><a href="#about">About</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#portfolio">Portfolio</a></li>
                <li><a href="#pricing">Pricing</a></li>
                <li><a href="#faq">FAQ</a></li>
            </ul>
            <a href="https://wa.me/917620858971?text=Hi%20Pranjali,%20I%20would%20like%20to%20enquire%20about%20makeup%20services." target="_blank" class="btn-gold">
                <i class="fab fa-whatsapp"></i> Book via WhatsApp
            </a>
            <div class="menu-toggle" id="menuToggle">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="hero-grid">
            <div class="hero-content">
                <span class="section-tag">Luxury Bridal & Editorial Artistry</span>
                <h2>Your Beauty, <span>Your Signature</span></h2>
                <p>Transform your special moments into timeless elegance with bespoke bridal makeup, HD airbrush artistry, and exquisite hairstyling crafted exclusively for you.</p>
                <div class="hero-buttons">
                    <a href="#booking" class="btn-gold">Book Appointment</a>
                    <a href="#portfolio" class="btn-outline">Explore Work</a>
                </div>
            </div>
            <div class="hero-img-stack">
                <div class="hero-img-box">
                    <img src="Model21.jpeg" alt="Pranjali Rawale Bridal Look">
                </div>
                <div class="hero-img-box">
                    <img src="mod14.jpeg" alt="Marathi Traditional Bride">
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="about" id="about">
        <div class="about-grid">
            <div class="about-image">
                <img src="Model22.jpeg" alt="Pranjali Rawale Professional Makeup Artist">
                <div class="experience-badge">
                    <span>5+</span>
                    Years of Excellence
