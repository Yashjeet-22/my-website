                        <label for="name">Full Name *</label>
                        <input type="text" id="name" class="form-control" placeholder="Enter your name" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input type="tel" id="phone" class="form-control" placeholder="Enter your phone number" required>
                    </div>
                    <div class="form-group">
                        <label for="eventDate">Event Date *</label>
                        <input type="date" id="eventDate" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="service">Select Service *</label>
                        <select id="service" class="form-control" required>
                            <option value="" disabled selected>Choose a service</option>
                            <option value="Royal Bridal Makeup">Royal Bridal Makeup (₹15,000)</option>
                            <option value="Engagement & Reception">Engagement & Reception (₹10,000)</option>
                            <option value="Party & HD Styling">Party & HD Styling (₹6,000)</option>
                            <option value="Pre-Bridal Trial">Pre-Bridal Trial</option>
                        </select>
                    </div>
                    <div class="form-group full">
                        <label for="message">Additional Notes / Venue Location</label>
                        <textarea id="message" class="form-control" rows="3" placeholder="Tell us about your venue, time, or specific requirements..."></textarea>
                    </div>
                </div>
                <button type="submit" class="btn-gold" style="width: 100%; justify-content: center; padding: 16px; font-size: 1.05rem;">
                    <i class="fab fa-whatsapp"></i> Send Booking Enquiry on WhatsApp
                </button>
            </form>
        </div>
    </section>

